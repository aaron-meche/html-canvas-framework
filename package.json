{
  "name": "@aaron-meche/ginger-ui",
  "version": "0.1.0",
  "description": "A small class-based JavaScript UI framework with Vite-powered file routes.",
  "license": "ISC",
  "author": "aaron-meche",
  "type": "module",
  "main": "./dist/ginger-ui.umd.cjs",
  "module": "./dist/ginger-ui.js",
  "exports": {
    ".": {
      "import": "./dist/ginger-ui.js",
      "require": "./dist/ginger-ui.umd.cjs"
    },
    "./source": "./js/index.js",
    "./interface": "./js/interface.js",
    "./router": "./js/router.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "js/index.js",
    "js/interface.js",
    "js/router.js",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "keywords": [
    "ui",
    "framework",
    "vite",
    "router",
    "javascript"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.js",
    "preview": "vite preview",
    "check": "npm run build && npm run build:demo",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
